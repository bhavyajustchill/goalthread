# Supervisor AI Configuration
SUPERVISOR_PROVIDER=openrouter
SUPERVISOR_MODEL=google/gemini-3.6-flash
SUPERVISOR_API_KEY=your_supervisor_api_key_here
SUPERVISOR_BASE_URL=

# Worker 1 AI Configuration
WORKER1_PROVIDER=openrouter
WORKER1_MODEL=deepseek/deepseek-v4-flash
WORKER1_API_KEY=your_worker1_api_key_here
WORKER1_BASE_URL=

# Worker 2 AI Configuration
WORKER2_PROVIDER=openrouter
WORKER2_MODEL=deepseek/deepseek-v4-flash
WORKER2_API_KEY=your_worker2_api_key_here
WORKER2_BASE_URL=

# Legacy Single Worker Configuration (Fallback)
WORKER_PROVIDER=openrouter
WORKER_MODEL=deepseek/deepseek-v4-flash
WORKER_API_KEY=your_worker_api_key_here
WORKER_BASE_URL=

# Fallback OpenRouter Credentials (Legacy)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SUPERVISOR_MODEL=google/gemini-3.6-flash
OPENROUTER_WORKER_MODEL=deepseek/deepseek-v4-flash

# GoalThread Retry Settings
GOALTHREAD_MAX_RETRIES=2

# GoalThread Environment Settings
GOALTHREAD_DB_PATH=./.goalthread/goalthread.db
GOALTHREAD_RUNS_DIR=./goalthread-runs
GOALTHREAD_LOG_LEVEL=info

