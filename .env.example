# Supervisor AI Credentials (Groq)
# llama-3.1-8b-instant has 30,000 TPM rate limit on Groq free tier
GROQ_API_KEY=your_groq_api_key_here
GROQ_SUPERVISOR_MODEL=llama-3.1-8b-instant

# Worker AI Credentials (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_WORKER_MODEL=deepseek/deepseek-v4-flash

# GoalThread Environment Settings
GOALTHREAD_DB_PATH=./.goalthread/goalthread.db
GOALTHREAD_RUNS_DIR=./goalthread-runs
GOALTHREAD_LOG_LEVEL=info
