# OpenRouter AI Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supervisor AI Model on OpenRouter (High reasoning accuracy & 1M+ TPM limits)
OPENROUTER_SUPERVISOR_MODEL=google/gemini-2.5-flash

# Worker AI Model on OpenRouter (High performance, cost-efficient executor)
OPENROUTER_WORKER_MODEL=deepseek/deepseek-v4-flash

# GoalThread Environment Settings
GOALTHREAD_DB_PATH=./.goalthread/goalthread.db
GOALTHREAD_RUNS_DIR=./goalthread-runs
GOALTHREAD_LOG_LEVEL=info
